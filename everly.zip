<style id="uic-a11y-contrast">
/* white-on-blue controls: 3.18 -> 4.54 */
input[type="submit"],.button,.button-one,.cta-button,#big-search-submit,
.post-content .button,.page-numbers.current,.edd-add-to-cart,
.edd_purchase_submit_wrapper .button{background:#297abe}
/* secondary grey button: 3.82 -> 4.57. The theme scopes these under #secondary
   and #content, so the overrides need the same id-level weight. */
.edd-demo-link,#secondary .edd-demo-link,#purchase-box .edd-demo-link{background:#687882}
#secondary .edd-add-to-cart,#content .edd-add-to-cart,#purchase-box .edd-add-to-cart,
#content .post-text .edd-add-to-cart,#content .download-wrapper .edd-add-to-cart{background:#297abe}
/* download meta tags on white: 2.48 -> 4.63 */
.meta-tag,#purchase-box .post-meta .meta-tag{color:#6e767b}
/* post-nav "Previous"/"Next" labels: 3.45 -> 4.51 */
.nav-previous .nav-text span,.nav-next .nav-text span{color:#6d7881}
/* footer text on #282e34: 1.92 -> 4.60 */
.site-footer,.site-footer a,.site-footer .copyright a,.widget .menu li a:before{color:#8997a5}
/* category pills on #dde4e8: 3.22 -> 4.53 */
.search-cats a{color:#5a6770}
/* "Or browse by category:" on #eee: 2.96 -> 4.52 */
.search-cat-text{color:#616e77}
/* EDD price chip on #eaf0f4: 2.63 -> 4.56 */
.edd_price,.download-meta-purchase,.download-meta-price-details a .edd_price{color:#616e77}
/* download meta links on white: 3.22 -> 4.57 */
.download-meta-name a,.edd-taxonomy-widget li a{color:#6c7782}
/* pagination on #dde3e7: 2.77 -> 4.59 */
.page-numbers{color:#5b656f}
/* post meta / widget links: 3.18-3.58 -> 4.55+ */
.posted-on,.post-date,.entry-meta,.entry-meta a{color:#6b7782}
.widget a,.footer-widget a{color:#646f7a}
.site-footer .widget a,.site-footer .footer-widget a{color:#8997a5}
/* these two need id-level specificity to beat the theme's own rules */
#secondary-page aside a{color:#6c7782}
.post-meta a,#secondary .post-meta a,.meta-cat a{color:#646f7a}
/* body link colour on white: 3.18 -> 4.54. Scoped rules for the dark header
   and footer keep their own colours, which are more specific than this. */
a{color:#297abe}
/* inline <code>: the theme rule is .post-content code (0,1,1), so match it.
   #c22d75 clears 4.5:1 on both the #f1f3f5 chip and a plain white background. */
code,.post-content code,.post-text code{color:#c22d75}
/* sidebar category links were 17px tall; WCAG 2.2 wants a 24px target */
.edd-taxonomy-widget li a{display:inline-block;padding-top:4px;padding-bottom:4px;min-height:24px;line-height:16px}
</style>
