<style id="uic-fd-inline-css">

		.uic-fd{margin:20px 0;text-align:left}
		.uic-fd *{text-align:left}
		.uic-fd .uic-fd__btn{text-align:center}
		.uic-fd__form{display:flex;flex-direction:column;gap:14px}
		.uic-fd__label{font-size:14px;font-weight:700;line-height:1.3;margin:0}
		.uic-fd .uic-fd__input{width:100%;height:54px;padding:0 16px;border:2px solid #dfe3ea;border-radius:10px;
			font-family:inherit;font-size:16px;color:#1b2230;background:#fff;transition:border-color .15s,box-shadow .15s}
		.uic-fd .uic-fd__input::placeholder{color:#a2aab8}
		.uic-fd .uic-fd__input:focus{outline:none;border-color:#4f46e5;box-shadow:0 0 0 4px rgba(79,70,229,.14)}
		.uic-fd__check{display:flex;gap:11px;align-items:flex-start;font-size:14px;line-height:1.5;color:#4b5563;cursor:pointer}
		.uic-fd .uic-fd__check input{width:18px;height:18px;margin:1px 0 0;accent-color:#4f46e5;flex-shrink:0;cursor:pointer}
		.uic-fd .uic-fd__btn{width:100%;min-height:54px;border:0;background:#4f46e5;color:#fff;font-family:inherit;
			font-size:16px;font-weight:700;line-height:1.2;padding:14px 18px;border-radius:10px;cursor:pointer;
			transition:background .15s,transform .1s}
		.uic-fd .uic-fd__btn:hover{background:#4338ca}
		.uic-fd .uic-fd__btn:active{transform:translateY(1px)}
		.uic-fd__small{font-size:13px;color:#7b8494;line-height:1.55;margin:0}
		.uic-fd__err{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;font-size:14px;line-height:1.5;
			padding:12px 14px;border-radius:10px;margin:0 0 14px}
		.uic-fd__sent{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:20px}
		.uic-fd__sent strong{display:block;font-size:17px;margin-bottom:8px;color:#14532d}
		.uic-fd__sent p{font-size:14px;color:#3f6b50;line-height:1.6;margin:0 0 8px}
		.uic-fd__sent p:last-child{margin-bottom:0}
		.uic-fd__sent a{color:#15803d;font-weight:700;text-decoration:underline}
		/* Off-screen rather than display:none — some bots skip hidden fields. */
		.uic-fd__hp{position:absolute!important;left:-9999px!important;width:1px;height:1px;overflow:hidden}
		
/*# sourceURL=uic-fd-inline-css */
</style>
